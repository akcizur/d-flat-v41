{
  "name": "d-flat-v41",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop FPS prototype inspired by DFLAT: low-poly exploration of a Czech socialist-era apartment block.",
  "main": "electron/main.cjs",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -s first \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "start": "electron .",
    "check:syntax": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check src/main.js && node --check src/game/world.js && node --check src/game/player.js && node --check scripts/check-architecture.mjs",
    "check": "node scripts/check-architecture.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:web": "vite build",
    "build": "npm run check:syntax && npm run check && npm run test && vite build",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "dist:mac": "npm run build && electron-builder --mac dmg"
  },
  "dependencies": {
    "three": "0.169.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "vite": "^8.3.5",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "cz.akcizur.dflatv41",
    "productName": "D-FLAT V41",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  },
  "type": "module"
}
